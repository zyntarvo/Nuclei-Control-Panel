# Normalize line endings. Everything that runs on the Ubuntu server must be LF.
* text=auto eol=lf
*.bat text eol=crlf

# Binary assets
*.png binary
*.ico binary

# GitHub language stats
docs/** linguist-documentation
*.svg linguist-documentation
*.md linguist-documentation
payload/templates/*.html linguist-language=HTML
nuclei_setup.py linguist-language=Python
payload/*.py linguist-language=Python
